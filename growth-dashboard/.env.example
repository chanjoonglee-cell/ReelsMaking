# ── Mixpanel 라이브 연동 ──────────────────────────────────────
# 키가 없으면 대시보드는 data/snapshot.json 의 실데이터 스냅샷으로 동작한다.
# 발급: Mixpanel → Settings → Organization Settings → Service Accounts
MIXPANEL_SERVICE_ACCOUNT_USERNAME=
MIXPANEL_SERVICE_ACCOUNT_SECRET=

# 프로젝트 ID (LanguageForest)
MIXPANEL_PROJECT_ID=3848333

# 저장된 퍼널 ID (Mixpanel에서 저장한 퍼널 리포트)
# 온보딩 전환율 퍼널 = 87198134 (기본값)
MIXPANEL_ONBOARDING_FUNNEL_ID=87198134
# 페이월→결제 퍼널을 Mixpanel에 저장했다면 그 ID를 넣으면 라이브로 전환됨.
# 비워두면 채널별 페이월 퍼널은 스냅샷 데이터를 사용.
MIXPANEL_PAYWALL_FUNNEL_ID=

# Query API 라이브 사용 여부.
# 현재 Mixpanel 플랜이 Query API 호출을 막아(402), 기본은 내장 실데이터(MCP 추출)를 사용한다.
# 플랜을 올려 Query API가 열리면 아래를 true 로 바꾸면 라이브로 동작한다.
MIXPANEL_QUERY_API_ENABLED=false

# 활성 유저(3일 1회+) 행동 코호트 ID
# Mixpanel → Users → Cohorts 에서 "app_open을 최근 30일 중 10일 이상" 같은
# 행동 코호트를 만들고, 그 ID를 넣으면 리텐션 '활성화' 세그먼트가 채워짐.
MIXPANEL_ACTIVE_COHORT_ID=

# 데이터 레지던시 (EU 프로젝트면 https://eu.mixpanel.com 으로 변경)
# MIXPANEL_API_HOST=https://mixpanel.com
